# Blue Carbon Registry - Environment Configuration

# API Configuration
VITE_API_BASE_URL=http://localhost:3001
VITE_API_TIMEOUT=10000

# Blockchain Configuration
VITE_RPC_URL=https://rpc.sepolia.org
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
VITE_CHAIN_ID=11155111

# IPFS Configuration (for file storage)
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/
VITE_IPFS_API_URL=https://api.pinata.cloud

# Authentication
VITE_JWT_SECRET=your-jwt-secret-key
VITE_AUTH_COOKIE_NAME=blue-carbon-auth

# File Upload Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=image/*,application/pdf,text/plain

# Feature Flags
VITE_ENABLE_DEMO_MODE=true
VITE_ENABLE_BLOCKCHAIN=true
VITE_ENABLE_IPFS=false

# External Services
VITE_MAPBOX_ACCESS_TOKEN=your-mapbox-token
VITE_SENTRY_DSN=your-sentry-dsn

# Development
VITE_DEBUG=true
VITE_LOG_LEVEL=debug

# Production overrides (only for production builds)
# VITE_API_BASE_URL=https://api.bluecarbon.org
# VITE_RPC_URL=https://mainnet.infura.io/v3/your-infura-key
# VITE_ENABLE_DEMO_MODE=false
# VITE_DEBUG=false
# VITE_LOG_LEVEL=error