import React, { useState, useEffect } from 'react';
import { useRoleAuth } from '../contexts/RoleAuthContext';
import { useBlockchain } from '../contexts/BlockchainContext';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../components/ui/card';
import { Button } from '../components/ui/button';
import { Badge } from '../components/ui/badge';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '../components/ui/tabs';
import { ShoppingCart, TrendingUp, Leaf, IndianRupee, Calendar, MapPin } from 'lucide-react';
import { FIXED_WALLETS } from '../utils/fixedWallets.js';
import { validateWalletConnection, showWalletTransactionInfo } from '../utils/walletUtils.js';
import { DemoBlockchainService } from '../utils/DemoBlockchainService.js';
import { tokenTransferService } from '../utils/TokenTransferService';

interface CreditOffer {
  id: string;
  ngoAddress: string;
  ngoName: string;
  credits: number;
  pricePerCredit: number;
  totalPrice: number;
  timestamp: string;
}

interface Purchase {
  id: string;
  offerId: string;
  ngoName: string;
  credits: number;
  totalPrice: number;
  purchaseDate: string;
  status: 'pending' | 'completed';
}

// Helper function to format currency in INR
const formatINR = (amount: number) => {
  return new Intl.NumberFormat('en-IN', {
    style: 'currency',
    currency: 'INR',
  }).format(amount);
};

export default function CompanyDashboard() {
  const { authState, logout } = useRoleAuth();
  const { executeTrade, isConnected, connectWallet, ethBalance, tokenBalance, walletAddress } = useBlockchain();
  const [availableOffers, setAvailableOffers] = useState<CreditOffer[]>([]);
  const [myPurchases, setMyPurchases] = useState<Purchase[]>([]);
  const [totalCreditsOwned, setTotalCreditsOwned] = useState(0);

  useEffect(() => {
    loadMarketplaceData();
  }, []);

  const loadMarketplaceData = () => {
    // Load available credit offers
    const offers = JSON.parse(localStorage.getItem('marketplace_offers') || '[]');
    setAvailableOffers(offers.map((offer: any, index: number) => ({
      ...offer,
      id: `offer_${index}_${Date.now()}`
    })));

    // Load company's purchases
    const purchases = JSON.parse(
      localStorage.getItem(`company_purchases_${authState.user?.address}`) || '[]'
    );
    setMyPurchases(purchases);

    // Calculate total credits owned
    const total = purchases
      .filter((p: Purchase) => p.status === 'completed')
      .reduce((sum: number, p: Purchase) => sum + p.credits, 0);
    setTotalCreditsOwned(total);
  };

  const purchaseCredits = async (offer: CreditOffer) => {
    // Check if wallet is connected
    if (!isConnected) {
      const shouldConnect = window.confirm('You need to connect your wallet to purchase credits. Connect now?');
      if (shouldConnect) {
        await connectWallet();
      }
      return;
    }

    // Check if connected wallet is the company wallet
    if (walletAddress?.toLowerCase() !== FIXED_WALLETS.COMPANY.toLowerCase()) {
      alert(`⚠️ Wrong Wallet Connected!\n\nPlease connect the COMPANY wallet:\n${FIXED_WALLETS.COMPANY}\n\nCurrently connected: ${walletAddress}`);
      return;
    }

    const confirmPurchase = window.confirm(
      DemoBlockchainService.DEMO_MODE
        ? `� Demo Mode: Purchase ${offer.credits} carbon credits from ${offer.ngoName} for ${formatINR(offer.totalPrice)}?\n\n✨ This will simulate a blockchain transaction for demonstration purposes.`
        : `�🌊 Purchase ${offer.credits} carbon credits from ${offer.ngoName} for ${formatINR(offer.totalPrice)}?\n\n💰 This will use real ETH from your connected wallet on Sepolia testnet.`
    );

    if (!confirmPurchase) return;

    try {
      // Convert INR price to ETH (approximate conversion)
      // Note: In production, you'd get real-time conversion rates
      const ethPriceInINR = 200000; // ~200k INR per ETH (approximate)
      const priceInEth = (offer.totalPrice / ethPriceInINR).toFixed(6);

      let result;
      
      if (DemoBlockchainService.DEMO_MODE) {
        result = await DemoBlockchainService.simulateCreditPurchase(offer.credits, priceInEth);
      } else {
        // Execute blockchain trade
        result = await executeTrade(
          offer.ngoAddress,
          offer.credits.toString(),
          priceInEth,
          `purchase-receipt-${Date.now()}.pdf` // PDF hash
        );
      }

      if (result.success) {
        // Create purchase record (keep local storage for UI display purposes)
        const purchase: Purchase = {
          id: `purchase_${Date.now()}`,
          offerId: offer.id,
          ngoName: offer.ngoName,
          credits: offer.credits,
          totalPrice: offer.totalPrice,
          purchaseDate: new Date().toLocaleDateString(),
          status: 'completed'
        };

        // Add to company's purchases
        const updatedPurchases = [...myPurchases, purchase];
        setMyPurchases(updatedPurchases);
        localStorage.setItem(
          `company_purchases_${authState.user?.address}`,
          JSON.stringify(updatedPurchases)
        );

        // Remove offer from marketplace
        const updatedOffers = availableOffers.filter(o => o.id !== offer.id);
        setAvailableOffers(updatedOffers);
        
        // Update marketplace offers in storage (remove purchased offer)
        const allOffers = JSON.parse(localStorage.getItem('marketplace_offers') || '[]');
        const filteredOffers = allOffers.filter((_: any, index: number) => 
          `offer_${index}_${Date.now()}` !== offer.id
        );
        localStorage.setItem('marketplace_offers', JSON.stringify(filteredOffers));

        // Update NGO's available credits (reduce their balance)
        const ngoCreditsKey = `ngo_credits_${offer.ngoAddress}`;
        const currentCredits = parseInt(localStorage.getItem(ngoCreditsKey) || '0');
        const newBalance = Math.max(0, currentCredits - offer.credits);
        localStorage.setItem(ngoCreditsKey, newBalance.toString());

        // Update total owned
        setTotalCreditsOwned(totalCreditsOwned + offer.credits);

        const successMessage = DemoBlockchainService.DEMO_MODE
          ? `✅ DEMO SUCCESS! Purchased ${offer.credits} carbon credits from ${offer.ngoName}!\n\n🎭 Mock Transaction Hash: ${result.txHash}\n🔗 Demo mode is active - switch to real blockchain once contracts are fixed!`
          : `✅ BLOCKCHAIN SUCCESS! Purchased ${offer.credits} carbon credits from ${offer.ngoName}!\n\n🔗 Transaction Hash: ${result.txHash}\n💰 Used ${priceInEth} ETH from your wallet`;
          
        alert(successMessage);
      } else {
        alert(`❌ ${DemoBlockchainService.DEMO_MODE ? 'Demo' : 'Blockchain'} transaction failed: ${result.error}`);
      }
    } catch (error: any) {
      alert(`❌ Purchase failed: ${error.message}`);
    }
  };

  if (!authState.isAuthenticated || authState.role !== 'COMPANY') {
    return <div>Access denied. Company role required.</div>;
  }

  return (
    <div className="min-h-screen bg-gray-50 p-6">
      <div className="max-w-7xl mx-auto">
        {/* Header */}
        <div className="flex justify-between items-center mb-8">
          <div>
            <h1 className="text-3xl font-bold text-gray-900">Company Dashboard</h1>
            <p className="text-gray-600">Welcome, {authState.user?.name}</p>
          </div>
          <Button onClick={logout} variant="outline">
            Logout
          </Button>
        </div>



        {/* Blockchain Status Card */}
        {!isConnected && (
          <Card className="mb-6 border-orange-200 bg-orange-50">
            <CardContent className="p-6">
              <div className="flex items-center justify-between">
                <div>
                  <h3 className="text-lg font-semibold text-orange-800">Connect Wallet for Blockchain Trading</h3>
                  <p className="text-sm text-orange-600">Connect your MetaMask wallet to make actual blockchain transactions with ETH</p>
                </div>
                <Button onClick={connectWallet} className="bg-orange-600 hover:bg-orange-700">
                  Connect Wallet
                </Button>
              </div>
            </CardContent>
          </Card>
        )}

        {isConnected && (
          <Card className="mb-6 border-green-200 bg-green-50">
            <CardContent className="p-6">
              <div className="flex items-center justify-between">
                <div>
                  <h3 className="text-lg font-semibold text-green-800">🔗 Wallet Connected - Blockchain Ready!</h3>
                  <p className="text-sm text-green-600">ETH Balance: {ethBalance} | Carbon Credits: {tokenBalance}</p>
                </div>
                <div className="text-green-600 font-mono text-sm">
                  Sepolia Testnet ✅
                </div>
              </div>
            </CardContent>
          </Card>
        )}

        {/* Stats Cards */}
        <div className="grid md:grid-cols-4 gap-6 mb-8">
          <Card>
            <CardContent className="p-6">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-sm font-medium text-gray-600">Credits Owned</p>
                  <p className="text-2xl font-bold text-green-600">{totalCreditsOwned}</p>
                </div>
                <Leaf className="w-8 h-8 text-green-500" />
              </div>
            </CardContent>
          </Card>

          <Card>
            <CardContent className="p-6">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-sm font-medium text-gray-600">Available Offers</p>
                  <p className="text-2xl font-bold text-blue-600">{availableOffers.length}</p>
                </div>
                <ShoppingCart className="w-8 h-8 text-blue-500" />
              </div>
            </CardContent>
          </Card>

          <Card>
            <CardContent className="p-6">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-sm font-medium text-gray-600">Total Purchases</p>
                  <p className="text-2xl font-bold text-purple-600">{myPurchases.length}</p>
                </div>
                <TrendingUp className="w-8 h-8 text-purple-500" />
              </div>
            </CardContent>
          </Card>

          <Card>
            <CardContent className="p-6">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-sm font-medium text-gray-600">Total Spent</p>
                  <p className="text-2xl font-bold text-orange-600">
                    {formatINR(myPurchases.reduce((sum, p) => sum + p.totalPrice, 0))}
                  </p>
                </div>
                <IndianRupee className="w-8 h-8 text-orange-500" />
              </div>
            </CardContent>
          </Card>
        </div>

        {/* Main Content */}
        <Tabs defaultValue="marketplace" className="space-y-6">
          <TabsList>
            <TabsTrigger value="marketplace">
              Carbon Credit Marketplace ({availableOffers.length})
            </TabsTrigger>
            <TabsTrigger value="portfolio">
              My Carbon Portfolio ({myPurchases.length})
            </TabsTrigger>
          </TabsList>

          {/* Marketplace Tab */}
          <TabsContent value="marketplace" className="space-y-6">
            <Card>
              <CardHeader>
                <CardTitle>Available Carbon Credits</CardTitle>
                <CardDescription>
                  Purchase verified blue carbon credits from NGO partners
                </CardDescription>
              </CardHeader>
              <CardContent>
                {availableOffers.length === 0 ? (
                  <div className="text-center py-12 text-gray-500">
                    <ShoppingCart className="w-12 h-12 mx-auto mb-4 text-gray-300" />
                    <h3 className="text-lg font-medium mb-2">No Credits Available</h3>
                    <p>Currently no carbon credits are listed for sale.</p>
                    <p className="text-sm mt-2">Check back later or contact NGO partners directly.</p>
                  </div>
                ) : (
                  <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {availableOffers.map((offer) => (
                      <Card key={offer.id} className="hover:shadow-lg transition-shadow">
                        <CardHeader>
                          <div className="flex justify-between items-start">
                            <CardTitle className="text-lg">{offer.ngoName}</CardTitle>
                            <Badge className="bg-green-100 text-green-800">
                              Verified
                            </Badge>
                          </div>
                          <CardDescription>
                            Blue carbon conservation credits
                          </CardDescription>
                        </CardHeader>
                        <CardContent className="space-y-4">
                          <div className="space-y-2">
                            <div className="flex justify-between">
                              <span className="text-sm font-medium">Credits Available:</span>
                              <span className="text-sm font-bold text-green-600">
                                {offer.credits} credits
                              </span>
                            </div>
                            <div className="flex justify-between">
                              <span className="text-sm font-medium">Price per Credit:</span>
                              <span className="text-sm font-bold">
                                {formatINR(offer.pricePerCredit)}
                              </span>
                            </div>
                            <div className="flex justify-between border-t pt-2">
                              <span className="font-medium">Total Price:</span>
                              <span className="font-bold text-lg">
                                {formatINR(offer.totalPrice)}
                              </span>
                            </div>
                          </div>

                          <div className="text-xs text-gray-500 flex items-center gap-1">
                            <Calendar className="w-3 h-3" />
                            Listed: {new Date(offer.timestamp).toLocaleDateString()}
                          </div>

                          <Button 
                            onClick={() => purchaseCredits(offer)}
                            className="w-full"
                          >
                            <ShoppingCart className="w-4 h-4 mr-2" />
                            Purchase Credits
                          </Button>
                        </CardContent>
                      </Card>
                    ))}
                  </div>
                )}
              </CardContent>
            </Card>
          </TabsContent>

          {/* Portfolio Tab */}
          <TabsContent value="portfolio" className="space-y-6">
            <Card>
              <CardHeader>
                <CardTitle>Carbon Credit Portfolio</CardTitle>
                <CardDescription>
                  Your purchased carbon credits and transaction history
                </CardDescription>
              </CardHeader>
              <CardContent>
                {myPurchases.length === 0 ? (
                  <div className="text-center py-12 text-gray-500">
                    <Leaf className="w-12 h-12 mx-auto mb-4 text-gray-300" />
                    <h3 className="text-lg font-medium mb-2">No Carbon Credits Yet</h3>
                    <p>You haven't purchased any carbon credits.</p>
                    <p className="text-sm mt-2">Visit the marketplace to start building your portfolio!</p>
                  </div>
                ) : (
                  <div className="space-y-4">
                    {/* Portfolio Summary */}
                    <div className="bg-green-50 border border-green-200 rounded-lg p-4 mb-6">
                      <h3 className="font-semibold text-green-900 mb-2">
                        Portfolio Summary
                      </h3>
                      <div className="grid md:grid-cols-3 gap-4">
                        <div>
                          <p className="text-sm text-green-700">Total Credits Owned</p>
                          <p className="text-2xl font-bold text-green-900">{totalCreditsOwned}</p>
                        </div>
                        <div>
                          <p className="text-sm text-green-700">Total Investment</p>
                          <p className="text-2xl font-bold text-green-900">
                            {formatINR(myPurchases.reduce((sum, p) => sum + p.totalPrice, 0))}
                          </p>
                        </div>
                        <div>
                          <p className="text-sm text-green-700">Average Price per Credit</p>
                          <p className="text-2xl font-bold text-green-900">
                            {totalCreditsOwned > 0 ? 
                              formatINR(myPurchases.reduce((sum, p) => sum + p.totalPrice, 0) / totalCreditsOwned)
                              : formatINR(0)
                            }
                          </p>
                        </div>
                      </div>
                    </div>

                    {/* Transaction History */}
                    <div className="space-y-3">
                      <h4 className="font-semibold">Transaction History</h4>
                      {myPurchases.map((purchase) => (
                        <div key={purchase.id} className="border rounded-lg p-4">
                          <div className="flex justify-between items-start mb-2">
                            <div>
                              <h5 className="font-semibold">{purchase.ngoName}</h5>
                              <p className="text-sm text-gray-600">
                                {purchase.credits} credits purchased
                              </p>
                            </div>
                            <div className="text-right">
                              <p className="font-bold">{formatINR(purchase.totalPrice)}</p>
                              <Badge className="bg-green-100 text-green-800 mt-1">
                                {purchase.status}
                              </Badge>
                            </div>
                          </div>
                          <div className="text-sm text-gray-500 flex items-center gap-4">
                            <span className="flex items-center gap-1">
                              <Calendar className="w-3 h-3" />
                              {purchase.purchaseDate}
                            </span>
                            <span>
                              Price per credit: {formatINR(purchase.totalPrice / purchase.credits)}
                            </span>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </CardContent>
            </Card>
          </TabsContent>
        </Tabs>
      </div>
    </div>
  );
}