{
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/auth?path=$1"
    },
    {
      "source": "/api/projects/(.*)", 
      "destination": "/api/projects?path=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api|_next|favicon.ico|robots.txt|assets).*)",
      "destination": "/index.html"
    }
  ]
}
