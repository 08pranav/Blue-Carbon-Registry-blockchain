# Environment file for Sepolia deployment
# Add your private key and RPC URL here

# Sepolia RPC URL (you can use Infura, Alchemy, or public RPC)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Private key for the wallet that will deploy/interact with contracts
# WARNING: Never commit this to version control in a real project
SEPOLIA_PRIVATE_KEY=your_private_key_here

# Etherscan API key for contract verification (optional)
ETHERSCAN_API_KEY=your_etherscan_api_key_here