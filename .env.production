# Production Environment Variables for Blue Carbon Registry

# API Configuration - empty for Vercel serverless functions
VITE_API_BASE_URL=

# Features - enable demo mode for production deployment
VITE_ENABLE_DEMO_MODE=true
VITE_ENABLE_BLOCKCHAIN=true
VITE_ENABLE_IPFS=false

# Development
VITE_DEBUG=false
VITE_LOG_LEVEL=error